# ==============================================
# 1. TELEGRAM BOT & ADMIN CONFIGURATION
# ==============================================
ADMIN_BOT_TOKEN=123456789:ABCDEF_your_bot_token_here
ADMIN_TELEGRAM_ID=123456789
BOT_USERNAME=YourHelperW_bot
DEFAULT_STYLE=adaptive_all

# ==============================================
# 2. TELEGRAM MINI APP & BACKEND API
# ==============================================
# Public HTTPS URL for launching the Telegram Mini App (e.g., https://app.example.com)
WEBAPP_URL=
API_HOST=0.0.0.0
API_PORT=8080
SESSION_SECRET_KEY=replace_with_strong_random_64_char_secret_in_production
INIT_DATA_MAX_AGE_SECONDS=86400
WEBHOOK_SECRET_TOKEN=
RATE_LIMIT_PER_MINUTE=120
ALLOW_DEMO_PAYMENTS=false

# ==============================================
# 3. TELEGRAM USERBOT (MTProto Fallback)
# ==============================================
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_telegram_api_hash_here
TELEGRAM_PHONE=+79991234567
TELEGRAM_SESSION_STRING=

# ==============================================
# 4. AI, CONTEXT, & VOICE SYNTHESIS
# ==============================================
GEMINI_API_KEY=your_gemini_api_key_here
# Optional comma-separated pool of Gemini API keys for automatic failover rotation:
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_TIMEOUT_SECONDS=25.0
GEMINI_MAX_RETRIES=2
AI_RECENT_WINDOW_SIZE=10
AI_SUMMARY_INTERVAL_MESSAGES=8

GROQ_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=oik5x6jBI6Xj6MPIciZU
VOICE_CHANCE=0.05

# ==============================================
# 5. PAYMENTS (@CryptoBot) & DATABASE
# ==============================================
CRYPTO_PAY_TOKEN=
CRYPTO_PAY_NET=mainnet
DATABASE_URL=sqlite+aiosqlite:///companion.db

# ==============================================
# 6. SCHEDULE & BEHAVIOR DEFAULTS
# ==============================================
DEFAULT_TIMEZONE=Europe/Moscow
DEFAULT_SLEEP_START=23:00
DEFAULT_SLEEP_END=08:30
REENGAGEMENT_MIN_HOURS=24
REENGAGEMENT_MAX_HOURS=72
AUTO_PAUSE_ON_MEETUP_PROPOSAL=true
MIN_REPLY_DELAY_SECONDS=10
MAX_REPLY_DELAY_SECONDS=45
