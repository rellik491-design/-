# ==========================================
# Telegram Companion AI Configuration
# ==========================================

# 1. Admin Bot Credentials (Главный бот управления и приёма лидов)
# Токен бота от @BotFather
ADMIN_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
# Telegram ID владельца (главного администратора) для уведомлений о лидах
ADMIN_TELEGRAM_ID=123456789
# Юзернейм бота (без @)
BOT_USERNAME=YourHelperW_bot
# Стиль общения по умолчанию: adaptive_all, shy, sarcastic, flirt, care
DEFAULT_STYLE=adaptive_all

# 2. Telegram Client MTProto (Опционально для Userbot через Telethon)
# Получить API_ID и API_HASH на https://my.telegram.org
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
TELEGRAM_SESSION_STRING=

# 3. AI Providers
# Google Gemini API key: https://aistudio.google.com
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-flash-lite-latest

# Speech-to-Text (STT) резервные провайдеры (опционально, Gemini по умолчанию)
GROQ_API_KEY=
OPENAI_API_KEY=

# Voice Generation (TTS)
# ElevenLabs (для естественных войсов девушки)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=oik5x6jBI6Xj6MPIciZU
VOICE_CHANCE=0.05

# Yandex SpeechKit (Опционально для синтеза русской речи)
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_VOICE=dasha
YANDEX_EMOTION=good

# 4. CryptoBot (@CryptoBot / Crypto Pay API, опционально)
CRYPTO_PAY_TOKEN=
CRYPTO_PAY_NET=mainnet

# 5. Database (SQLite async по умолчанию, также поддерживается PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///companion.db

# 6. Режим дня и поведение
DEFAULT_TIMEZONE=Europe/Moscow
DEFAULT_SLEEP_START=23:00
DEFAULT_SLEEP_END=08:30
REENGAGEMENT_MIN_HOURS=24
REENGAGEMENT_MAX_HOURS=72
AUTO_PAUSE_ON_MEETUP_PROPOSAL=true
MIN_REPLY_DELAY_SECONDS=10
MAX_REPLY_DELAY_SECONDS=45
